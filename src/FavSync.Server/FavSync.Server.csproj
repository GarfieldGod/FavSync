<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mfav</AssemblyName>
    <RootNamespace>FavSync.Server</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FavSync.Core\FavSync.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- 随包分发的外部工具全部落 <产物>\tools\<工具名>\，与仓库里的 tools\ 一一对应：
       tools\7z\（7za.exe + 许可证）、tools\adb\（adb.exe + 两个 WinApi dll）。
       它们都是被 Process.Start 起的**子进程**，不是被 CLR 加载的 native 库，
       所以每一行都必须 ExcludeFromSingleFile —— 否则会塞进 exe 的 bundle，
       而 SevenZip.Resolve / AdbClient.Resolve 是在 AppContext.BaseDirectory 下找真实文件 → 功能直接失效。 -->
  <ItemGroup>
    <None Include="..\..\tools\7z\7za.exe" Link="tools\7z\7za.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\tools\7z\License-7zip.txt" Link="tools\7z\License-7zip.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\tools\adb\adb.exe" Link="tools\adb\adb.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\tools\adb\AdbWinApi.dll" Link="tools\adb\AdbWinApi.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\tools\adb\AdbWinUsbApi.dll" Link="tools\adb\AdbWinUsbApi.dll" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- 单文件发布相关属性在 FavSync.Desktop.csproj（发布主项目）；SelfContained 由根目录
       publish.sh 以命令行全局属性传入（否则 Server 作为 Sdk.Web 的 Exe 会触发 NETSDK1150）。 -->

  <!-- Web 页编进程序集：一个 exe 拿走就能跑，不会出现"忘了拷 wwwroot"的 404 -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
