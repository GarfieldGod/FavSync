# 不在仓库内；这里兜底，防止有人把库放在源码目录里误提交。
.favsync/
.incoming/
.trash/
catalog.db
catalog.db-shm
catalog.db-wal

# ---- 本地配置（含扫码登录后的 SESSDATA 等登录态）----
config.json
*.wbtest

# ---- IDE / 编辑器 ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user

# ---- 临时文件与备份 ----
*.bak
*.tmp
*.log
__pycache__/
*.pyc
